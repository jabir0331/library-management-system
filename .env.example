# Copy this file to `.env` and fill in real values. `.env` is git-ignored.
# Real environment variables (e.g. IDE run config, CI, Docker) take precedence over .env.

# --- Database (PostgreSQL) ---
DB_URL=jdbc:postgresql://localhost:5432/library_db
DB_USERNAME=postgres
DB_PASSWORD=change-me

# --- JWT ---
# Required. Random string of at least 32 characters, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
# Optional, token lifetime in milliseconds (default 3600000 = 1 hour)
# JWT_EXPIRATION_MS=3600000

# --- First admin (only used when the admin table is empty) ---
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@library.local
BOOTSTRAP_ADMIN_PASSWORD=change-me
